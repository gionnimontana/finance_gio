# Deploy target domain used to render the checked-in Nginx template and compute /var/www/<domain>.
PFB_DEPLOY_SITE_DOMAIN=finance.example.com

# SSH helper settings for npm run ssh:connect.
PFB_DEPLOY_SSH_HOST=203.0.113.10
PFB_DEPLOY_SSH_USER=deploy
# PFB_DEPLOY_SSH_PORT=22
# PFB_DEPLOY_SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# PFB_DEPLOY_SSH_PRIVATE_KEY=
# PFB_DEPLOY_SSH_PASSWORD=
PFB_DEPLOY_SSH_STRICT_HOST_KEY_CHECKING=true
# PFB_DEPLOY_SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Remote deploy helper settings for npm run deploy:remote.
PFB_DEPLOY_APP_PATH=/home/financegio

# Optional release override for the generated frontend asset version.
# PFB_FRONTEND_VERSION=manual-release-id
